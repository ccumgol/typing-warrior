{
  "name": "typing-warrior",
  "version": "1.1.0",
  "description": "한글/영문 타자연습 - 자소, 단어, 문장, 게임, 단축키",
  "main": "src/main/main.cjs",
  "type": "module",
  "author": "Gihyun Park (박기현)",
  "license": "MIT",
  "homepage": "https://github.com/ccumgol/typing-warrior",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccumgol/typing-warrior.git"
  },
  "funding": "https://buymeacoffee.com/ccumgol",
  "bugs": {
    "url": "https://github.com/ccumgol/typing-warrior/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "serve": "node tools/serve.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:win-zip": "electron-builder --win zip --x64 -c.win.signAndEditExecutable=false",
    "dist:win-installer": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.typingwarrior.app",
    "productName": "Typing Warrior",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Typing-Warrior-${version}-win-x64-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Typing Warrior",
      "uninstallDisplayName": "Typing Warrior",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ]
    },
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "afterPack": "build/after-pack.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Typing Warrior"
}
