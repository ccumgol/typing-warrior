{
  "name": "typing-warrior",
  "version": "1.1.0",
  "description": "한글/영문 타자연습 - 자소, 단어, 문장, 게임, 단축키",
  "main": "src/main/main.cjs",
  "type": "module",
  "author": "Gihyun Park (박기현)",
  "license": "MIT",
  "homepage": "https://github.com/ccumgol/typing-warrior",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccumgol/typing-warrior.git"
  },
  "funding": "https://buymeacoffee.com/ccumgol",
  "bugs": {
    "url": "https://github.com/ccumgol/typing-warrior/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "serve": "node tools/serve.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:win-zip": "electron-builder --win zip --x64 -c.win.signAndEditExecutable=false",
    "dist:win-installer": "electron-builder --win nsis --x64 --publish never",
    "dist:mac-notarized": "APPLE_KEYCHAIN_PROFILE=typing-warrior electron-builder --mac",
    "dist:mas": "electron-builder --mac mas --universal",
    "screenshots": "electron tools/screenshots.cjs",
    "dist:msstore": "electron-builder --win appx --x64 --publish never",
    "serve:lan": "HOST=0.0.0.0 PORT=5180 node tools/serve.mjs"
  },
  "build": {
    "appId": "com.typingwarrior.app",
    "productName": "Typing Warrior",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "mas": {
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "ElectronTeamID": "QYB6DPBR6X",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Typing-Warrior-${version}-win-x64-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Typing Warrior",
      "uninstallDisplayName": "Typing Warrior",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ]
    },
    "appx": {
      "identityName": "ccumgol.TypingWarriorBiblePoetry",
      "publisher": "CN=F056DC6C-2FA7-4C7F-B3A6-150A3E1399A7",
      "publisherDisplayName": "ccumgol",
      "displayName": "Typing Warrior: Bible &amp; Poetry",
      "applicationId": "TypingWarrior",
      "backgroundColor": "#1e3a8a",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "artifactName": "Typing-Warrior-${version}-win-x64-store.${ext}"
    },
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "afterPack": "build/after-pack.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Typing Warrior"
}
